# Runtime
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Shared secret with apps/api (required). Sent as X-Service-Key.
AI_SERVICE_KEY=change-me-shared-service-key

# LLM providers — model names must come from env, never hardcoded in code
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM behavior
LLM_PROVIDER_ORDER=groq,gemini
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
LLM_MAX_CONCURRENCY=10
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60

# Job Sources & Company Research
USE_DEMO_JOBS=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
RAPIDAPI_KEY=
SERPER_API_KEY=
GREENHOUSE_BOARDS=airbnb,stripe,github,cloudflare,datadog
LEVER_BOARDS=netflix,spotify,palantir,figma

