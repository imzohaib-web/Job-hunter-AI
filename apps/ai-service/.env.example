# Runtime
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Shared secret with apps/api (required). Sent as X-Service-Key.
AI_SERVICE_KEY=change-me-shared-service-key

# LLM providers — model names must come from env, never hardcoded in code
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM behavior
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
